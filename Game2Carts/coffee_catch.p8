pico-8 cartridge // http://www.pico-8.com
version 43
__lua__
pot_x = 56
drops = {}
score = 0
hi    = 0
lives = 3
tick  = 0
spd   = 1
rate  = 60
msg   = ""
mcol  = 9
mtmr  = 0
state = 0  -- 0=title 1=play 2=over
otmr  = 0

pot_y = 108
pot_w = 16

local SLOT_POINTS = 1
local SLOT_RETURN = 2
local PARENT_CART = "between_level.p8"

function _init()
 cartdata("coffee_catch_v1")
 hi = dget(0)

 menuitem(1, "main menu", function()
    load("main_menu.p8")
    end)
  menuitem(2, "before enemy combat", function()
    load("waffles_erics_copy.p8")
    end)
    
end

function _update()
 tick += 1

 if state == 0 then
  if btnp(4) then
   -- start
   pot_x=56 drops={} score=0 lives=3
   tick=0 spd=1 rate=60 msg="" mtmr=0
   state=1
  end
  return
 end

 if state == 2 then
  otmr -= 1
  if btnp(5) then return_to_overworld(score) end
  if otmr<=0 or btnp(4) then state=0 end
  return
 end

 -- play
 if mtmr>0 then mtmr-=1 end

 if btn(0) then pot_x-=2.5 end
 if btn(1) then pot_x+=2.5 end
 pot_x = mid(2, pot_x, 109)

 if tick%rate==0 then
  add(drops,{x=4+rnd(116),y=-4,s=spd+rnd(0.8)})
  if score>50 and rnd(1)<0.3 then
   add(drops,{x=4+rnd(116),y=-4,s=spd+rnd(0.8)})
  end
 end

 for d in all(drops) do
  d.y += d.s
  if d.y+3>=pot_y and d.y<pot_y+6
  and d.x>=pot_x-2 and d.x<=pot_x+pot_w+2 then
   del(drops,d)
   score+=1
   msg="+" mcol=11 mtmr=40
   if score%10==0 then
    spd=min(spd+0.3,4)
    rate=max(rate-5,20)
    msg="faster!" mcol=9 mtmr=60
   end
   if score>hi then hi=score dset(0,hi) end
  elseif d.y>128 then
   del(drops,d)
   lives-=1
   msg="miss!" mcol=8 mtmr=50
   if lives<=0 then state=2 otmr=200 end
  end
 end
end

function _draw()
 cls(1)
 palt(0,true)

 if state==0 then
  rectfill(0,100,127,127,13)
  rectfill(0,98,127,101,6)
  print("coffee catch",28,20,9)
  print("catch the drops",22,34,7)
  print("hi: "..hi,4,4,7)
  spr(32,52,88,3,2)
  if tick%60<30 then print("z to play",43,108,9) end
  if tick%60<30 then print("x to leave",42,116,9) end
  if btnp(5) then return_to_overworld(0) end
  return
 end

 if state==2 then
  rectfill(20,30,107,98,0)
  rect(20,30,107,98,9)
  print("game over",38,38,8)
  print("score: "..score,36,52,7)
  print("best:  "..hi,36,62,9)
  local g,c
  if     score>=40 then g,c="perfect! s",9
  elseif score>=25 then g,c="great!    a",11
  elseif score>=15 then g,c="good      b",12
  elseif score>=8  then g,c="ok        c",7
  else                   g,c="spilled!  f",8 end
  print(g,28,76,c)
  print("x retry  o leave",24,90,7)
  if btnp(4) then
    pot_x=56 drops={} score=0 lives=3
    tick=0 spd=1 rate=60 msg="" mtmr=0
    state=1
  end
  if btnp(5) then return_to_overworld(score) end
  return
 end

 -- play
 rectfill(0,96,127,127,13)
 rectfill(0,94,127,97,6)

 pal(12,4)
 for d in all(drops) do spr(2,d.x-4,d.y-4) end
 pal()
 spr(32,pot_x,pot_y,3,2)

 rectfill(0,0,127,9,0)
 print("score:"..score,2,2,7)
 print("hi:"..hi,70,2,6)
 for i=1,lives do
  pal(5,12) spr(0,128-i*10,1) pal()
 end

 local p=(spd-1)/3
 rectfill(2,120,30,122,0)
 rectfill(2,120,2+p*28,122,9)
 print("spd",2,123,6)

 if mtmr>0 then print(msg,50,14,mcol) end
end

function return_to_overworld(pts)
 cartdata("fightbufferv1")
 dset(1,pts)
 dset(2,1)
 load("between_level.p8")
end
