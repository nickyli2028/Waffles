__lua__
#include scripts/utilities/gamedata.lua
#include scripts/utilities/car_logic.lua
#include scripts/utilities/interactables.lua
#include scripts/characters/npcs.lua
#include scripts/utilities/enemy_registry.lua
#include scripts/utilities/transitions.lua
#include scripts/utilities/talk.lua
#include scripts/utilities/textbox.lua

anims = {
  down  = {64,  66,  68},
  left  = {70,  72,  74},
  right = {70,  72,  74},
  up    = {102, 104, 106},
}
objects = {}

cam_x, cam_y = 0, 0

local map_mx = 0
local map_my = 60
cars = {}
transition_lock = 0
map_coords={x=0,y=0}
current_room_name = "store_front" 

rooms={
  store_inside = {x=0, y=16,  w=32, h=16},
  store_front  = {x=0, y=32, w=32, h=32},
}
arrive_positions = {
  store_inside = {x=128, y=128},
  store_front    = {x=128, y=128},
}

map_coords={x=rooms.store_front.x, y=rooms.store_front.y}

doors={
  {from="store_front", to="store_inside", tile_x=25, tile_y=45, arrive_x=1, arrive_y=30},
}

--button x hold down
hold_timer = 0
hold_threshold = 5


function _init()
  player = {
    x = 116, y = 444,
    spd = 2,
    dir = "down", 
    moving = false,
    anim_t = 0,
    frame = 0,
  }

  objects = {
    {x=2,  y=20, id=2}, -- 2; coffee catch
    {x=4,  y=20, id=12}, -- 12; soda fountain
    {x=6,  y=20, id=96}, -- 96-97; fries
    {x=8,  y=20, id=101},  -- 101; egg bacon tic tac toe
  }
  cartdata("fightbufferv1")
  load_gamedata()
  check_minigame_return()
  fade_to_black()
  on_fade_done = function()
    start_dialogue("new_day")
  end
  mode = "overworld"
  for i = 1, 2 do spawn_car() end

  menuitem(1, "main menu", function()
    load("main_menu.p8")
    end)
  menuitem(2, "before enemy combat", function()
    load("waffles_erics_copy.p8")
    end)

  --npcs
  --[[spawn_npc(
    newcord("x", MAP_CORD_X), 
    newcord("y", MAP_CORD_Y), 
    SPRITE_ID,
    {AUTOMATED PATH},
    "DIALOG NAME", 
    SHIRT COLOR, 
    HAIR COLOR)]]
  spawn_npc(
    newcord("x", 11), 
    newcord("y", 21), 
    14,
    {}, 
    "bench_npc", 
    13, 
    14)

  spawn_npc(
    newcord("x", 30), 
    newcord("y", 30), 
    98,
    {}, 
    "trenchcoat")

  spawn_npc(
    newcord("x", 1), 
    newcord("y", 26), 
    14,
    {}, 
    "diner", 
    11, 
    8)

  spawn_npc(
    newcord("x", 5), 
    newcord("y", 26), 
    14,
    {}, 
    "diner", 
    1, 
    9)
  
end

function _update()
  transition_update()

  if reading or choice_active then
    tb_update()
    update_choice()
    return
  end
  if in_minigame() then
    minigames_update()
    return
  end

  if btn(5) then
    hold_timer += 1
  else
      hold_timer = 0
  end

  if hold_timer >= hold_threshold and get_nearby_npc() == nil and not is_interactable(get_nearby_tile()) then
      return
  end

  if btnp(4) then
    local nearby_npc = get_nearby_npc()
    if nearby_npc then
      start_dialogue(nearby_npc.name)
    else
      local nearby = get_nearby_tile()
      if is_interactable(nearby) then interact(nearby) end
    end
  end

  local dx, dy = 0, 0
  if btn(0) then dx = -1  player.dir = "left"  end
  if btn(1) then dx =  1  player.dir = "right" end
  if btn(2) then dy = -1  player.dir = "up"    end
  if btn(3) then dy =  1  player.dir = "down"  end

  if dx ~= 0 and dy ~= 0 then
    dx *= 0.707
    dy *= 0.707
  end

  local nx = player.x + dx * player.spd
  local ny = player.y + dy * player.spd

  if not is_solid(nx, player.y) then player.x = nx end
  if not is_solid(player.x, ny) then player.y = ny end

  player.moving = (dx ~= 0 or dy ~= 0)

  check_doors()
  move_map()

  local room_px = map_coords.x * 8
  local room_py = map_coords.y * 8
  local current_room = rooms[current_room_name]
  cam_x = mid(room_px, player.x - 56, room_px + current_room.w * 8 - 120)
  cam_y = mid(room_py, player.y - 56, room_py + current_room.h * 8 - 120)

  if player.moving then
    player.anim_t += 1
    if player.anim_t >= 10 then
      player.anim_t = 0
      player.frame += 1
      if player.frame > 2 then player.frame = 1 end
    end
  else
    player.anim_t = 0
    player.frame = 0
  end

  
  update_npcs()
  update_cars()
  update_choice()
end

street_counter = 0
street_msg_shown = false

function is_solid(x, y)
  if x == nil or y == nil then return false end
  
  local corners = {
    {x + 2,  y + 9 },
    {x + 13, y + 9 },
    {x + 2,  y + 15},
    {x + 13, y + 15},
  }
  for _, c in ipairs(corners) do
    local tx = flr(c[1] / 8)
    local ty = flr(c[2] / 8)
    if tx >= 0 and ty >= 0 and tx < 128 and ty < 128 then
      local tile = mget(tx, ty)
      if fget(tile, 0) then return true end
      if fget(tile, 1) then 
        if not reading and not street_msg_shown then 
          if street_counter < 3 then 
            show_message("i can't cross the street.") 
          elseif street_counter < 6 then
            show_message("why do i have this urge to go\ninto traffic.") 
          else
            show_message("insert crossyroad")
          end
          street_counter += 1
          street_msg_shown = true
        end
        return true 
      end
    end
  end
  street_msg_shown = false  -- reset when not touching street
  return false
end

function _draw()  
  if in_minigame() then
    minigames_draw()
    return
  end

  cls()
  camera(cam_x, cam_y)
  map(map_coords.x, map_coords.y, map_coords.x * 8, map_coords.y * 8, 33, 33)
  pal(0, 130, 1) 
  map(1, 17, 1*8, 17*8, 15, 4)
  pal(0, 0, 1)
  palt(0, false)
  palt(2, true)
  palt(11, true)

  --mini games
  for _, obj in pairs(objects) do
      spr(obj.id, newcord("x", obj.x), newcord("y", obj.y))
  end

  local a = anims[player.dir]
  local spr_id = a[player.frame + 1]
  local flip_x = (player.dir == "right")

  local cell_x = flr(player.x / 8)
  local cell_y = flr(player.y / 8)
  for name, coords in pairs(rooms) do
    if map_coords.x == coords.x and map_coords.y == coords.y then
      print(name, cam_x + 2, cam_y + 120, 7)
    end
  end


  --print("px:"..flr(player.x)..","..flr(player.y), cam_x + 2, cam_y + 2,  7)
    --print("cel:"..cell_x..","..cell_y,               cam_x + 2, cam_y + 8,  7)
   -- print("dir:"..player.dir,                        cam_x + 2, cam_y + 14, 7)
   -- print(mget(0,0), cam_x+2, cam_y+2, 7)
  local tx = flr(player.x / 8)
  local ty = flr(player.y / 8)

    --furniture
  for tx = 13, 27, 2 do -- booths
    for ty = 21, 25, 4 do
      spr(43, newcord("x", tx), newcord("y", ty), 2, 2)
    end
  end

  for tx = 1, 10 do --stools
    spr(13, newcord("x", tx), newcord("y", 25), 1, 2)
  end
  for tx = 1, 10, 2 do --oven things
    spr(45, newcord("x", tx), newcord("y", 21), 2, 2)
  end

  draw_npcs()  
  spr(spr_id, player.x, player.y, 2, 2, flip_x)

  for tx = 1, 10 do -- kitchen table
    spr(28, newcord("x", tx), newcord("y", 24))
  end


  draw_road()
  draw_cars()
  draw_interact_prompt()
  tb_draw()
  draw_choice()
  --point inventory
  if btn(5) and not reading and not in_minigame() then
    if hold_timer >= hold_threshold then
        rectfill(cam_x+20, cam_y+40, cam_x+107, cam_y+88, 0)
        rect(cam_x+20, cam_y+40, cam_x+107, cam_y+88, 9)
        print("minigame points", cam_x+28, cam_y+50, 9)
        print(dget(0), cam_x+56, cam_y+64, 7)
    end
end
  transition_draw()
end

function newcord(where, target)
  if where == "x" then return target * 8
  elseif where == "y" then return target * 8
  end
end

function in_room(name)
  local r = rooms[name]
  return r and map_coords.x == r.x and map_coords.y == r.y
end


function check_doors()
  if not player or not player.x then return end
  
  local px = flr((player.x + 8) / 8)
  local py = flr((player.y + 8) / 8)

  for _, door in ipairs(doors) do
    if in_room(door.from) then
      local world_tx = door.tile_x
      local world_ty = door.tile_y
      if px == world_tx and py == world_ty then
        goto_room(door.to)
        player.x = door.arrive_x * 8
        player.y = door.arrive_y * 8
        return
      end
    end
  end
end

function move_map()
  if transition_lock > 0 then
    transition_lock -= 1
    return
  end
  local rx = map_coords.x * 8
  local ry = map_coords.y * 8
  if player.x >= rx + 248 then shift_room(1, 0)
  elseif player.x <= rx + 4 then shift_room(-1, 0)
  elseif player.y >= ry + 248 then shift_room(0, 1)
  elseif player.y <= ry + 4 then shift_room(0, -1)
  end
end

function shift_room(dx, dy)
  map_coords.x += dx * 32
  map_coords.y += dy * 32
  local rx = map_coords.x * 8
  local ry = map_coords.y * 8
  if dx ~= 0 then
    player.x = dx > 0 and rx + 8 or rx + 240
  end
  if dy ~= 0 then
    player.y = dy > 0 and ry + 8 or ry + 240
  end
  transition_lock = 10
end

function teleport(room_name)
  goto_room(room_name)
  local pos = arrive_positions[room_name]
  if pos then
    player.x = pos.x
    player.y = pos.y
  end
end

function goto_room(name)
  fade_to_black()
  local r = rooms[name]
  if r then
    map_coords.x = r.x
    map_coords.y = r.y
    current_room_name = name
  end
end

