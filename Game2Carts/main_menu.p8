pico-8 cartridge // http://www.pico-8.com
version 43
__lua__
splash_state = 0
splash_timer = 0
splash_delay = 2
cam_y = 0
cam_target = 95
cy = 1
ticks = 10
vol = 4

--worker animation
anim_frame = 0
anim_timer = 0
frames = {80, 97, 113, 97, 80}

mbutts = {
    "start", function() load("waffles_eric.p8") end,
    "options", function() splash_state = 5 end,
    "credits", function() splash_state = 3 end,
    "quit", function() splash_state = 4 end
}

function _init()
    music(0)
end

function _update()
    ticks += 1
    if ticks > 60 then ticks = 1 end

    anim_timer += 1
    if anim_timer >= 10 then
        anim_timer = 0
        anim_frame = (anim_frame + 1) % #frames
    end

    if splash_state == 0 then
        splash_timer += 1/30
        if splash_timer >= splash_delay then
            splash_state = 1
        end

    elseif splash_state == 1 then
        cam_y += (cam_target - cam_y) * 0.2
        if abs(cam_y - cam_target) < 0.5 then
            cam_y = cam_target
            splash_state = 2
        end

    elseif splash_state == 2 then
        if btnp(2) then cy -= 1 end
        if btnp(3) then cy += 1 end
        cy = mid(1, cy, #mbutts/2)
        if btnp(4) then mbutts[cy*2]() end
    elseif splash_state == 3 then
        if btnp(4) then splash_state = 2 end
    elseif splash_state == 4 then
       if btnp(4) then extcmd("shutdown") end
       if btnp(5) then splash_state = 2 end 
    elseif splash_state == 5 then
       if btnp(0) then vol = max(0, vol-1) end
        if btnp(1) then vol = min(8, vol+1) end
        if btnp(4) then splash_state = 2 end 
    end
end

function _draw()
    cls()
    palt(0, false)
    if splash_state == 0 or splash_state == 1 then
        if ticks % 30 < 15 then frame = 24 end
        local sx = (frame % 16) * 8
        local sy = flr(frame / 16) * 8
        camera(0, 0)
        map(0, 0, 0, 0, 8, 8)
    end

    camera(0, cam_y)
    --pal(11, 135, 1)
    --pal(9, 137, 1)
    pal(5, 132, 1)
    pal(3, 135, 1)
    sspr(1, 1, 72, 127, -16, 0, 146, 264)
    sspr(80, 0, 32, 32, 100, 16, 16, 16)

    palt(11, true)
    sspr(frames[anim_frame+1], 40, 16, 24, 11, 180)

    -- menu options
    if splash_state == 2 then
        mdesc = {
        "nOT THAT ONE",
        "gETTING CLOSER",
        "cOOL PEOPLE",
        "yEAH!"
    }
        for i, p in pairs(mbutts) do
            if i % 2 == 1 then
                local x = 96-#p*2
                local y = cam_target+60+i*8
                print(p, x, y, 10)
                if cy*2-1 == i then
                    print(">", x-6, y, 9)
                end
            end
            local desc = mdesc[cy]
            local tw = #desc * 4  -- text width in pixels
            local tx = 64 - tw    -- centered x
            local ty = cam_target + 70
            local pad = 4

            rectfill(tx-pad, ty-pad, tx+tw+pad, ty+8+pad, 0)
            print(desc, tx, ty, 7)
        end
    --credits screne
    elseif splash_state == 3 then
        rectfill(10, cam_target+10, 118, cam_target+100, 0)
        rect(10, cam_target+10, 118, cam_target+100, 7)
        print("credits", 50, cam_target+20, 7)
        print("nICKY lI", 20, cam_target+35, 6)
        print("eRIC nGUYEN", 20, cam_target+45, 6)
        print("kAYLAH aLLISON-bALL", 20, cam_target+55, 6)
        print("[z] to go back", 20, cam_target+85, 6)
    --quit screen
    elseif splash_state == 4 then
        rectfill(20, cam_target+30, 108, cam_target+70, 0)
        rect(20, cam_target+30, 108, cam_target+70, 7)
        print("quit game?", 45, cam_target+40, 7)
        print("x: yes  o: no", 35, cam_target+55, 6)
    --options
    elseif splash_state == 5 then
        rectfill(10, cam_target+10, 118, cam_target+100, 0)
        rect(10, cam_target+10, 118, cam_target+100, 7)
        print("volume", 50, cam_target+20, 7)
        -- meter background
        rectfill(20, cam_target+40, 108, cam_target+50, 5)
        -- meter fill based on vol
        rectfill(20, cam_target+40, 20 + vol*11, cam_target+50, 10)
        print("<  >", 48, cam_target+55, 6)
        print("[z] to go back", 20, cam_target+85, 6)
    end
end
__gfx__
