pico-8 cartridge // http://www.pico-8.com
version 43
__lua__
-- ============================================
-- shape tracer - standalone game
-- ============================================
-- modes: 0=title  1=playing  2=round_clear
--        3=game_over
-- ============================================
local SLOT_POINTS = 1
local SLOT_RETURN = 2
local PARENT_CART = "between_level.p8"

function _init()
 build_shapes()
 title_screen()

 menuitem(1, "main menu", function()
    load("main_menu.p8")
    end)
  menuitem(2, "before enemy combat", function()
    load("waffles_erics_copy.p8")
    end)
    
end

function title_screen()
 mode=0
 hi=hi or 0
end

function new_game()
 mode=1
 round=1
 score=0
 mistakes=0
 round_time=15        -- seconds per shape, decreases each round
 shapes_done=0        -- shapes completed this round
 round_size=5         -- shapes per round
 build_round()
end

function build_round()
 -- shuffle globallist into a fresh queue
 local pool={}
 for s in all(globallist) do add(pool,s) end
 -- fisher-yates
 for i=#pool,2,-1 do
  local j=flr(rnd(i))+1
  pool[i],pool[j]=pool[j],pool[i]
 end
 -- take round_size shapes (wrap if needed)
 queue={}
 for i=1,round_size do
  add(queue, pool[(i-1)%#pool+1])
 end
 q_idx=1
 load_shape(queue[q_idx])
end

function load_shape(s)
 -- deep-copy so consuming input doesn't wreck globallist
 t={x=s.x, y=s.y, input={}, loc={}}
 for v in all(s.input) do
  if type(v)=="table" then
   add(t.input,{v[1],v[2]})
  else
   add(t.input,v)
  end
 end
 for v in all(s.loc) do add(t.loc,{v[1],v[2]}) end
 shape_mistakes=0
 frame_ignore=0
 shape_timer=time()+round_time
end

function _update()
 if mode==0 then
  if btnp(4) or btnp(5) then new_game() end
  return
 end
 if mode==2 then
  if btnp(4) or btnp(5) then
   round+=1
   round_time=max(5, round_time-2)
   shapes_done=0
   build_round()
   mode=1
  end
  return
 end
 if mode==3 then
  if btnp(4) or btnp(5) then title_screen() end
  return
 end

 -- playing
 if time()>shape_timer then
  -- timeout = fail this shape
  fail_shape()
  return
 end
 check_input()
end

function check_input()
 if frame_ignore>0 then
  frame_ignore-=1
  return
 end

 local n=t.input[1]
 if n==nil then return end

 -- correct press?
 local hit=false
 if type(n)=="table" then
  if btn(n[1]) and btn(n[2]) then hit=true end
 else
  if btnp(n) then hit=true end
 end

 if hit then
  deli(t.input,1)
  deli(t.loc,1)
  frame_ignore=1
  if #t.input==0 then
   -- shape complete!
   score+=max(1, flr((shape_timer-time())*10))
   shapes_done+=1
   if shapes_done>=round_size then
    -- round clear
    if score>hi then hi=score end
    mode=2
   else
    q_idx+=1
    load_shape(queue[q_idx])
   end
  end
  return
 end

 -- wrong press?
 local dirs={0,1,2,3}
 for d in all(dirs) do
  if wrong_press(d,n) then
   shape_mistakes+=1
   mistakes+=1
   frame_ignore=3
   if mistakes>=4 then
    if score>hi then hi=score end
    mode=3
   end
   return
  end
 end
end

function wrong_press(dir,expected)
 if not btnp(dir) then return false end
 if type(expected)=="table" then
  return expected[1]~=dir and expected[2]~=dir
 end
 return expected~=dir
end

function fail_shape()
 mistakes+=1
 frame_ignore=0
 if mistakes>=4 then
  if score>hi then hi=score end
  mode=3
  return
 end
 -- reload same shape, same time budget (no extra penalty beyond mistake)
 load_shape(queue[q_idx])
end

-- ============================================
-- draw
-- ============================================
function _draw()
 cls()
 if mode==0 then draw_title()
 elseif mode==1 then draw_game()
 elseif mode==2 then draw_round_clear()
 elseif mode==3 then draw_gameover()
 end
end

function draw_title()
 cls(0)
 print("shape tracer",34,30,7)
 print("trace the shape",28,45,6)
 print("with d-pad inputs",24,53,5)
 print("❎ to start",38,80,7)
 if btnp(5) then return_to_overworld(0) end
 if hi>0 then
  print("hi "..hi,46,100,9)
 end
end

function draw_game()
 -- hud bar at top
 rectfill(0,0,127,5,1)
 -- timer bar
 local t_pct=(shape_timer-time())/round_time
 t_pct=mid(0,t_pct,1)
 local bar_w=flr(t_pct*127)
 local bar_col=10
 if t_pct<0.4 then bar_col=8 end
 if t_pct<0.2 then bar_col=2 end
 rectfill(0,0,bar_w,5,bar_col)

 -- score / round
 print("rnd "..round,1,8,6)
 print(score,90,8,7)

 -- mistake hearts (4 max)
 for i=0,3 do
  local col=8
  if i>=mistakes then col=2 end
  print("♥",1+i*8,120,col)
 end

 -- round progress dots bottom right
 for i=1,round_size do
  local col=1
  if i<shapes_done+1 then col=11
  elseif i==shapes_done+1 then col=7
  end
  circfill(127-round_size*6+i*6-3,122,2,col)
 end

 -- shape panel
 draw_shape_panel()

 -- prompt: show next expected input
 draw_prompt()
end

function draw_shape_panel()
 -- hatched yellow bg
 fillp(0b0100011111100010)
 rectfill(26,16,100,90,0x35)
 fillp(█)
 rect(26,16,100,90,2)

 -- palette remap: crimson=traced, navy=untraced
 for i=16-#t.input%13,15 do pal(i,2) end
 for i=3,15-#t.input%13 do pal(i,1) end
 sspr(t.x+#t.input\13*16,t.y,16,16,31,21,64,64)
 pal()

 -- current dot
 sspr(10,1,1,1,31+t.loc[1][1]*4,21+t.loc[1][2]*4,4,4)
 -- next dot
 if #t.loc>1 then
  sspr(10,3,1,1,31+t.loc[2][1]*4,21+t.loc[2][2]*4,4,4)
 end
end

function draw_prompt()
 local n=t.input[1]
 if n==nil then return end
 local chars={[0]="⬅️",[1]="➡️",[2]="⬆️",[3]="⬇️"}
 local cols={[0]=8,[1]=9,[2]=11,[3]=12}
 if type(n)=="table" then
  -- diagonal: show both
  print(chars[n[1]],44,104,cols[n[1]])
  print("+",54,104,7)
  print(chars[n[2]],62,104,cols[n[2]])
 else
  print(chars[n],54,104,cols[n])
 end
end

function draw_round_clear()
 cls(0)
 print("round "..round.." clear!",28,40,11)
 print("score: "..score,40,56,7)
 local next_t=max(5,round_time-2)
 print("next: "..next_t.."s/shape",32,70,6)
 print("❎ continue",38,96,7)
end

function draw_gameover()
 cls(0)
 print("game over",40,40,8)
 print("score: "..score,40,56,7)
 print("best:  "..hi,40,66,9)
 print("❎ retry",44,96,7)
 if btnp(4) then new_game() end
if btnp(5) then return_to_overworld(score) end
end

function return_to_overworld(points_earned)
  cartdata("fightbufferv1")
  dset(SLOT_POINTS, points_earned or 0)
  dset(SLOT_RETURN, 1)
  load(PARENT_CART)
end

-- ============================================
-- shape data (verbatim from original)
-- ============================================
function build_shapes()
 local cube={
  x=16,y=32,input={⬆️,⬅️,⬇️,➡️},
  loc={{13,14},{13,2},{2,2},{2,13},{13,13}}}
 local wtaf={
  x=80,y=48,input={➡️,{⬆️,⬅️},➡️,⬇️,{⬆️,➡️},⬅️,{⬇️,⬅️}},
  loc={{0,13},{9,13},{4,8},{11,8},{11,12},{14,3},{3,3},{1,13}}}
 local triangle={
  x=16,y=48,input={➡️,{⬆️,⬅️},{⬅️,⬇️}},
  loc={{0,13},{15,13},{8,2},{1,12}}}
 local fish={
  x=80,y=32,input={{⬇️,➡️},➡️,{⬆️,➡️},{⬇️,➡️},⬆️,{⬇️,⬅️},{⬆️,⬅️},{⬇️,⬅️}},
  loc={{1,7},{4,12},{6,12},{9,8},{13,12},{13,3},{10,6},{7,3},{2,7}}}
 local circle={
  x=32,y=32,input={➡️,{⬆️,➡️},⬆️,{⬆️,⬅️},⬅️,{⬅️,⬇️},⬇️,{⬇️,➡️}},
  loc={{4,13},{10,13},{13,10},{13,5},{10,2},{5,2},{2,5},{2,10},{4,12}}}
 local bigx={
  x=48,y=32,input={➡️,{⬆️,➡️},{⬇️,➡️},➡️,⬆️,{⬆️,⬅️},{⬆️,➡️},⬆️,⬅️,{⬇️,⬅️},{⬆️,⬅️},⬅️,⬇️,{⬇️,➡️},{⬇️,⬅️},⬇️},
  loc={{0,13},{4,13},{8,10},{11,13},{14,13},{14,10},{12,7},{14,5},{14,2},{11,2},{7,5},{4,2},{1,2},{1,5},{3,8},{1,10},{1,12}}}
 local rctngl={
  x=48,y=48,input={➡️,⬆️,⬅️,⬇️},
  loc={{3,13},{11,13},{11,2},{4,2},{4,12}}}
 local star={
  x=64,y=48,input={{⬇️,⬅️},⬅️,{⬇️,➡️},{⬇️,⬅️},➡️,{➡️,⬆️},{⬇️,➡️},{⬆️,⬅️},⬆️,➡️,{⬆️,⬅️}},
  loc={{8,1},{4,6},{1,7},{4,10},{1,13},{4,13},{8,10},{13,14},{11,8},{11,7},{14,7},{9,2}}}
 local crystal={
  x=32,y=48,input={➡️,{➡️,⬆️},⬆️,⬅️,{⬅️,⬇️},⬇️},
  loc={{0,13},{7,13},{14,6},{14,2},{8,2},{1,9},{1,12}}}
 local tri2={
  x=96,y=32,input={{⬇️,⬅️},⬆️,{⬇️,➡️},⬆️,➡️,{⬅️,⬇️}},
  loc={{8,8},{1,15},{1,2},{7,8},{7,2},{14,2},{9,7}}}
 globallist={cube,wtaf,triangle,
  fish,circle,bigx,
  rctngl,star,crystal,
  tri2}
end
