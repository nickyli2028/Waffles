pico-8 cartridge // http://www.pico-8.com
version 43
__lua__
local SLOT_POINTS = 1
local SLOT_RETURN = 2
local PARENT_CART = "between_level.p8"
-- page 1: setup + main loop

x = 60                    -- line x
hook = {x = 60, y = 0, hooked = false}

cam_x = 0
cam_y = 0

game_state = 0            -- 0 splash, 1 game, 2 game over
fishes = {}
fishing_line = 0
throw_state = false
reel_state = false
ticks = 0
money = 0
♥ = 3

function _init()
	if game_state == 0 then
		music(0)
	elseif game_state == 1 then
		music(-1)
		music(44)
	end

	menuitem(1, "main menu", function()
    load("main_menu.p8")
    end)
  menuitem(2, "before enemy combat", function()
    load("waffles_erics_copy.p8")
    end)
	
end

function _update()
	ticks += 1
	if ticks == 30 then ticks = 1 end
	
	if game_state == 0 then
		update_splash()
	elseif game_state == 1 then
		update_game()
	elseif game_state == 2 then
		update_gameover()
	end
end

function _draw()
	cls(7)
	map(0, 0, 0, 0, 16, 32)
	
	-- camera follow
	if hook.y > 120 and cam_y < 120 then
		cam_y += 5
	elseif hook.y < 120 and cam_y > 0 then
		cam_y -= 5
	end
	camera(cam_x, cam_y)
	
	if game_state == 0 then
		draw_splash()
	elseif game_state == 1 then
		draw_game()
	elseif game_state == 2 then
		draw_gameover()
	end
end
-->8
-- page 2: core game logic

function update_splash()
	if btn(5) then
		game_state = 1
	end
end

function draw_splash()
	rectfill(10, 20, 114, 104, 9)
	print("just some deep fry", 28, 30, 0)
	print("reel", 57, 45, 0)
	print("⬆️", 60, 53)
	print("left ⬅️ ➡️ right", 34, 59)
	print("⬇️", 60, 65, 0)
	print("lower hook", 45, 71)
	print("spam 🅾️ to catch items", 20, 80, 0)
	print("press ❎ to start", 28, 90, 0)
end

function update_game()
	if money > 25 then fishing_line = 1 end
	if money > 49 or ♥ == 0 then
		game_state = 2
	end
	
	if hook.y == 0 then
		reel_state = false
		throw_state = false
		hook.hooked = false
	end
	
	update_fish()
	update_cast()
	update_hook()
end

function update_gameover()
	hook.y = 0
	if btnp(5) then return_to_overworld(money) end

end

function draw_game()
	print("$" .. money, 3, 3, 9)
	print("♥" .. ♥, 115, 3, 8)
	spr(66, hook.x, hook.y)
	curve()
	draw_fish()
end

function draw_gameover()
	rectfill(10, 20, 114, 104, 9)
	print("just some deep fry", 28, 30, 0)
	if money > 49 then
		print("eww dont tell fda!", 32, 42, 0)
	else
		print("call a sanitaion", 24, 42, 0)
	end
end
-->8
-- page 3: hook + casting

function update_cast()
	if throw_state == false and reel_state == false then
		if btn(⬅️) then x -= 2 end
		if btn(➡️) then x += 2 end
		
		if x > 128 then x = 128 end
		if x < 0 then x = 0 end
	end
	
	if btn(⬇️) and hook.y == 0 then
		throw_state = true
	end
	
	if hook.y == 0 then
		hook.x = x
	end
	
	if throw_state then
		throw()
	end
end

function throw()
	if fishing_line == 0 then
		if hook.y < 120 then hook.y += 3 end
		if hook.y == 120 then throw_state = false end
	else
		if hook.y < 240 then hook.y += 3 end
		if hook.y == 240 then throw_state = false end
	end
end

function update_hook()
	if throw_state == false and reel_state == false then
		if btn(⬆️) then
			hook.y -= 2
		end
		if hook.y < 0 then hook.y = 0 end
		if hook.x < 0 then hook.x = 0 end
		if hook.x > 120 then hook.x = 120 end
	end
	
	local follow_speed = 0.1
	hook.x += (x - hook.x) * follow_speed
end

function curve()
	local x1, y1 = x, 0
	local x2, y2 = hook.x + 3, hook.y
	local midx = (x1 + x2) / 2
	local midy = (y1 + y2) / 2 + 10
	
	local prevx, prevy = x1, y1
	for t = 0, 1, 0.05 do
		local xt = (1-t)^2 * x1 + 2*(1-t)*t * midx + t^2 * x2
		local yt = (1-t)^2 * y1 + 2*(1-t)*t * midy + t^2 * y2
		line(prevx, prevy, xt, yt, 0)
		prevx, prevy = xt, yt
	end
end

function reel()
	if hook.y > 0 then hook.y -= 3 end
end
-->8
-- sprites systems (optimized)

function add_fish()
	local fish = {x=0, y=0, level=0, sx=0, sy=1, tpe=0, dir=0, hooked=false}
	
	fish.dir = rnd({0,1})
	fish.sx = rnd({1,2})
	fish.tpe = flr(rnd(12))
	if fish.tpe > 8 then fish.tpe = 0 end
	
	if fish.tpe < 4 then
		fish.y = rnd(110) + 10
	elseif fish.tpe < 6 then
		fish.y = rnd(100) + 128
	elseif fish.tpe < 7 then
		fish.y = 240
	elseif fish.tpe == 7 then
		fish.y = rnd(30) + 200
	else -- rat
		fish.y = rnd(80) + 20
	end
	
	fish.level = fish.y
	if fish.dir == 0 then
		fish.sx = -fish.sx
		fish.x = 128
	end
	
	add(fishes, fish)
end

function update_fish()
	if ticks == 1 or ticks == 15 then add_fish() end
	
	for fish in all(fishes) do
		fish.x += fish.sx
		
		if fish.hooked then
			fish.x = hook.x
			fish.y = hook.y
			
			if hook.y == 0 then
				if     fish.tpe == 0 then money += 5
				elseif fish.tpe < 4 then money += 7
				elseif fish.tpe < 6 then money += 10
				elseif fish.tpe == 6 then money += 15
				elseif fish.tpe == 7 then money += 25
				elseif fish.tpe == 8 then money += 8 end
				
				fish.hooked = false
				del(fishes, fish)
				hook.hooked = false
			end
		end
		
		if collide(fish) and not hook.hooked then
			if btn(🅾️) and not throw_state then
				hook.hooked = true
				fish.sx = 0
				fish.hooked = true
			end
		end
		
		if fish.hooked then
			reel_state = true
			pull(fish)
		end
		
		if fish.x > 132 or fish.x < -8 then
			del(fishes, fish)
		end
	end
end

function collide(fish)
	local size = fish.tpe == 8 and 32 or 8
	return fish.x < hook.x + 6 and hook.x < fish.x + size
	   and fish.y < hook.y + 6 and hook.y < fish.y + size
end

function pull(fish)
	local highy, lowy = 15, 15
	if fish.tpe < 4 then
		highy, lowy = 15, 15
	elseif fish.tpe < 6 then
		highy, lowy = 50, 10
	elseif fish.tpe == 6 then
		highy, lowy = 75, 10
	elseif fish.tpe == 7 then
		highy, lowy = 100, 5
	elseif fish.tpe == 8 then
		highy, lowy = 35, 15
	end
	
	local dy = 0
	if hook.y < (fish.level - highy) then
		reel()
	elseif hook.y > (fish.level + lowy) then
		hook.hooked = false
		fish.hooked = false
		♥ -= 1
		fish.level = fish.y
		fish.sx = fish.dir == 1 and 1 or -1
		reel_state = false
	else
		if fishing_line == 1 and btnp(🅾️) then dy += 13
		elseif btnp(🅾️) then dy += 8 end
		dy -= fish.sy
		hook.y -= dy
	end
	if hook.y < 0 then hook.y = 0 end
end

-- optimized draw function
function draw_fish()
	for fish in all(fishes) do
		local flip = fish.dir == 1
		local rx = fish.x
		local ry = fish.y
		
		if fish.tpe < 4 then
			spr(1 + fish.tpe, rx, ry, 1, 1, flip)
		elseif fish.tpe == 4 then
			spr(19, rx, ry, 2, 2, flip)
		elseif fish.tpe == 5 then
			spr(16, rx, ry, 3, 2, flip)
		elseif fish.tpe == 6 then
			spr(134, rx, ry, 3, 3, flip)
		elseif fish.tpe == 7 then
			spr(129, rx, ry, 5, 4, flip)
		elseif fish.tpe == 8 then
			sspr(40, 0, 32, 16, rx, ry, 32, 16, flip)
			-- 40,0 = pixel position of sprite 5
			-- 32x16 = 4 tiles wide れ❎ 2 tiles tall
		end
	end
end

function return_to_overworld(pts)
 cartdata("fightbufferv1")
 dset(1,pts)
 dset(2,1)
 load("between_level.p8")
end

