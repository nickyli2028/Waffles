pico-8 cartridge // http://www.pico-8.com
version 43
__lua__
--the old family game is
--back with a new look!

--board definitions--
--independent variables--
b_x=16
b_y=16
b_size=96
--dependent variables--
t1=b_size/3
t2=2*b_size/3

function _init()
	cls()
	reset_game()
	game_state=5
	score_lim=2
	press_start_blink=1
	arrow_pos=0
	palt(0,false)
	palt(4,true)
	soundflag=0
	--game_state legend
	--0 draw
	--1 player circle win
	--2 player cross win
	--3 game ocurring
	--4 menu
	--5 press start
end

function _draw()
	cls()
	rectfill(0,0,128,128,1) --background color
	if(game_state>3) then
		sspr(0,0,24,24,27,9,72,72) --title 
		sspr(32,0,5,5,26,112,10,10) --pico icon
		print("built in pico-8",40,115,7)
	end
	if(press_start_blink<16 and game_state==5) then
		print("press 🅾️ button!",32,94,7)
	elseif(game_state==4) then
		spr(3,30,89+arrow_pos*11) --arrow in menu
		print("start game",35,89,7)
		print("best out of:",35,100,7)
		print(score_lim*2-1,86,100,7)
	elseif(game_state<4) then
		symbol_draw()
		board_draw()
		selector_draw(12)
		score_draw()
		if(game_state==1) then
			if(score[1]==score_lim) then
				print("player 🅾️ wins match!",24,5)
			else
				print("player 🅾️ scores!",32,5)
			end
		elseif(game_state==2) then
			if(score[2]==score_lim) then
				print("player ❎ wins match!",24,5)
			else
				print("player ❎ scores!",32,5)
			end
		elseif(game_state==0) then
			print("draw!",56,5)
		elseif(game_state==3 and who==1) then
			print("player 🅾️'s turn",33,5)
		elseif(game_state==3 and who==2) then
			print("player ❎'s turn",33,5)
		end
	end
end

function _update()
	if(game_state==5)then
		press_start_blink+=1
		if(press_start_blink==30) then
			press_start_blink=1
		end
		if(btnp(4)) then 
			game_state=4 
		end
	elseif(game_state==4) then
		if(btnp(2) or btnp(3)) then
			arrow_pos = 1 - arrow_pos
		elseif(arrow_pos==0 and btnp(4)) then
			game_state=3
		elseif(arrow_pos==1) then
			if(btnp(0) and score_lim>1) then score_lim-=1
			elseif(btnp(1)  and score_lim<8) then score_lim+=1
			end
		end
	elseif(game_state<4) then
		--move selector--
		if(btnp(0) and p_pos[1]>1) then p_pos[1]-=1
		elseif(btnp(1) and p_pos[1]<3) then p_pos[1]+=1
		elseif(btnp(2) and p_pos[2]>1) then p_pos[2]-=1
		elseif(btnp(3) and p_pos[2]<3) then p_pos[2]+=1 
		end
		--press--
		if(btnp(4)) then 
			if(game_state==3 and st[p_pos[1]+3*(p_pos[2]-1)]==0) then
				st[p_pos[1]+3*(p_pos[2]-1)]=who
				who = 3 - who
				soundflag=who
			elseif(game_state<3) then
				reset_board()
				if(score[1]==score_lim or score[2]==score_lim) then
					reset_game()
				end
			end
		end
		--wincheck--
		if(game_state==3) then
			if(st[1]==1 and st[2]==1 and st[3]==1) then end_game(1)
			elseif(st[4]==1 and st[5]==1 and st[6]==1) then end_game(1)
			elseif(st[7]==1 and st[8]==1 and st[9]==1) then end_game(1)
			elseif(st[1]==1 and st[4]==1 and st[7]==1) then end_game(1)
			elseif(st[2]==1 and st[5]==1 and st[8]==1) then end_game(1)
			elseif(st[3]==1 and st[6]==1 and st[9]==1) then end_game(1)
			elseif(st[1]==1 and st[5]==1 and st[9]==1) then end_game(1)
			elseif(st[3]==1 and st[5]==1 and st[7]==1) then end_game(1)
			
			elseif(st[1]==2 and st[2]==2 and st[3]==2) then end_game(2)
			elseif(st[4]==2 and st[5]==2 and st[6]==2) then end_game(2)
			elseif(st[7]==2 and st[8]==2 and st[9]==2) then end_game(2)
			elseif(st[1]==2 and st[4]==2 and st[7]==2) then end_game(2)
			elseif(st[2]==2 and st[5]==2 and st[8]==2) then end_game(2)
			elseif(st[3]==2 and st[6]==2 and st[9]==2) then end_game(2)
			elseif(st[1]==2 and st[5]==2 and st[9]==2) then end_game(2)
			elseif(st[3]==2 and st[5]==2 and st[7]==2) then end_game(2)
			
			elseif(st[1]~=0 and st[2]~=0 and st[3]~=0 and st[4]~=0 and st[5]~=0 and st[6]~=0 and st[7]~=0 and st[8]~=0 and st[9]~=0) then end_game(0) end
		end
	end
	soundcheck()
end

function soundcheck()
	if(soundflag==1) then sfx(1) --x played
	elseif(soundflag==2) then sfx(3) --o played
	elseif(soundflag==3) then sfx(2) --o wins
	elseif(soundflag==4) then sfx(0) end --x wins
	soundflag=0
end

function end_game(who)
	if(who==1) then 
		score[1]+=1
		game_state=1
		soundflag=3
	elseif(who==2) then 
		score[2]+=1
		game_state=2
		soundflag=4
	else
		game_state=0
	end
end
	
function reset_board()
	--init board--
	st={0,0,0,
		0,0,0,
		0,0,0}
	p_pos={1,1}
	--who's turn--
	game_state=3
end

function reset_game()
	who=1
	reset_board()
	score={0,0}
	game_state=4
end

function board_draw()
	--pretas
	color(0)
	line(b_x+t1+1,b_y,b_x+t1+1,b_y+b_size)
	line(b_x+t2+1,b_y,b_x+t2+1,b_y+b_size)
	line(b_x,b_y+t1+1,b_x+b_size,b_y+t1+1)
	line(b_x,b_y+t2+1,b_x+b_size,b_y+t2+1)
	--brancas
	color(7)
	line(b_x+t1,b_y,b_x+t1,b_y+b_size)
	line(b_x+t2,b_y,b_x+t2,b_y+b_size)
	line(b_x,b_y+t1,b_x+b_size,b_y+t1)
	line(b_x,b_y+t2,b_x+b_size,b_y+t2)
end

function selector_draw(c)
	sx1=b_x+p_pos[1]*t1
	sy1=b_y+p_pos[2]*t1
	sx0=sx1-t1
	sy0=sy1-t1
	rect(sx0,sy0,sx1,sy1,c)
end

function symbol_draw()
  for a=1,3 do
    for b=1,3 do
      local v = st[a+3*(b-1)]
      if v~=0 then
        local cx = b_x + (a-1)*t1 + 1
        local cy = b_y + (b-1)*t1 + 1
        local sid = v==1 and 5 or 9
        sspr((sid%16)*8, (sid\16)*8, 32, 32, cx, cy, 32, 32)
      end
    end
  end
end


function score_draw()
	color(7)
	print("🅾️ score:",2,121)
	print("❎ score:",81,121)
	print(score[1],40,121)
	print(score[2],119,121)
end
