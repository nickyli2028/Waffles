  loc={{0,13},{7,13},{14,6},{14,2},{8,2},{1,9},{1,12}}}
 
 local tri2={
 x=96,y=32,input={{⬇️,⬅️},⬆️,{⬇️,➡️},⬆️,➡️,{⬅️,⬇️}},
